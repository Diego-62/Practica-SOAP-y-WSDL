<?xml version="1.0" encoding="UTF-8"?>
<definitions name="ConversionesService"
             targetNamespace="http://practica.soap/conversiones"
             xmlns="http://schemas.xmlsoap.org/wsdl/"
             xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
             xmlns:tns="http://practica.soap/conversiones"
             xmlns:xsd="http://www.w3.org/2001/XMLSchema">

  <!-- 1. TIPOS: elementos de entrada y salida de cada operación -->
  <types>
    <xsd:schema targetNamespace="http://practica.soap/conversiones"
                elementFormDefault="qualified">

      <xsd:element name="CelsiusAFahrenheit">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="celsius" type="xsd:double"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
      <xsd:element name="CelsiusAFahrenheitResponse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="fahrenheit" type="xsd:double"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <xsd:element name="KilometrosAMillas">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="kilometros" type="xsd:double"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
      <xsd:element name="KilometrosAMillasResponse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="millas" type="xsd:double"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

    </xsd:schema>
  </types>

  <!-- 2. MENSAJES: entrada y salida de cada operación -->
  <message name="CelsiusAFahrenheitSoapIn">
    <part name="parameters" element="tns:CelsiusAFahrenheit"/>
  </message>
  <message name="CelsiusAFahrenheitSoapOut">
    <part name="parameters" element="tns:CelsiusAFahrenheitResponse"/>
  </message>
  <message name="KilometrosAMillasSoapIn">
    <part name="parameters" element="tns:KilometrosAMillas"/>
  </message>
  <message name="KilometrosAMillasSoapOut">
    <part name="parameters" element="tns:KilometrosAMillasResponse"/>
  </message>

  <!-- 3. PORT TYPE: operaciones y su correspondencia con los mensajes -->
  <portType name="ConversionesPortType">
    <operation name="CelsiusAFahrenheit">
      <input message="tns:CelsiusAFahrenheitSoapIn"/>
      <output message="tns:CelsiusAFahrenheitSoapOut"/>
    </operation>
    <operation name="KilometrosAMillas">
      <input message="tns:KilometrosAMillasSoapIn"/>
      <output message="tns:KilometrosAMillasSoapOut"/>
    </operation>
  </portType>

  <!-- 4. BINDING: vinculación con SOAP -->
  <binding name="ConversionesBinding" type="tns:ConversionesPortType">
    <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
    <operation name="CelsiusAFahrenheit">
      <soap:operation soapAction="http://practica.soap/conversiones/CelsiusAFahrenheit"/>
      <input><soap:body use="literal"/></input>
      <output><soap:body use="literal"/></output>
    </operation>
    <operation name="KilometrosAMillas">
      <soap:operation soapAction="http://practica.soap/conversiones/KilometrosAMillas"/>
      <input><soap:body use="literal"/></input>
      <output><soap:body use="literal"/></output>
    </operation>
  </binding>

  <!-- 5. SERVICE: nombre del servicio y dirección HTTP del endpoint -->
  <service name="ConversionesService">
    <port name="ConversionesPort" binding="tns:ConversionesBinding">
      <soap:address location="http://localhost:3000/soap/conversiones"/>
    </port>
  </service>

</definitions>